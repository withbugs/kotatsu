---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import VisualCredit from '../components/VisualCredit.astro';
import { assetPath, categories, visibleArticles } from '../lib/kotatsu';

const volumes = await getCollection('volumes');
const allArticles = visibleArticles(await getCollection('articles'));
const publishedVolumeSlugs = new Set(
  allArticles
    .filter((article) => article.data.status === 'published')
    .map((article) => article.data.volume)
);
const volume = [...volumes]
  .filter((entry) => publishedVolumeSlugs.has(entry.slug))
  .sort((a, b) => b.data.number - a.data.number)[0]
  ?? [...volumes].sort((a, b) => b.data.number - a.data.number)[0];
const volumeArticles = allArticles.filter((article) => article.data.volume === volume.slug);
const hasPublishedVolumeArticles = volumeArticles.some((article) => article.data.status === 'published');
const volumeIsPlanning = volume.data.status === 'planning' && !hasPublishedVolumeArticles;
const publishedVolumeArticles = volumeArticles.filter((article) => article.data.status === 'published');
const leadArticle = publishedVolumeArticles.find((article) => article.data.kind === 'cover-story')
  ?? publishedVolumeArticles[0]
  ?? volumeArticles[0];
const secondaryArticles = volumeArticles.filter((article) => article.id !== leadArticle?.id);
const volumeNumber = String(volume.data.number).padStart(3, '0');
const articleSectionTitle = volume.data.number === 1 ? '創刊Vol.の記事' : `Vol. ${volumeNumber}の記事`;
const heroImage = volume.data.coverImage || leadArticle?.data.heroImage || '/logo.svg';
const heroAlt = volume.data.coverAlt || leadArticle?.data.heroAlt || 'KOTATSU';
const heroVisual = volume.data.coverImage ? volume.data.visual : (leadArticle?.data.visual ?? volume.data.visual);
---
<BaseLayout title="KOTATSU" description={volume.data.subtitle} image={assetPath(volumeIsPlanning ? '/logo.svg' : heroImage)}>
  <main>
    <section class:list={['home-hero', { 'home-hero--planning': volumeIsPlanning }]}>
      {volumeIsPlanning ? (
        <div class="home-hero__paper"></div>
      ) : (
        <>
          <img src={assetPath(heroImage)} alt={heroAlt} />
          <div class="home-hero__shade"></div>
        </>
      )}
      <div class="home-hero__copy">
        <p class="volume-label">Vol. {volumeNumber}</p>
        <img class="home-hero__logo" src={assetPath('/logo.svg')} alt="KOTATSU" />
        <p class="home-hero__volume">{volume.data.title}</p>
        <p class="home-hero__lead">{volume.data.subtitle}</p>
        <div class="home-hero__links">
          <a class:list={['text-link', { 'text-link--light': !volumeIsPlanning }]} href={assetPath(`/volumes/${volume.slug}/`)}>
            {volumeIsPlanning ? '準備状況を見る' : 'Read this volume'}
          </a>
          <a class:list={['text-link', { 'text-link--light': !volumeIsPlanning }]} href={assetPath('/volumes/')}>
            Volume archive
          </a>
        </div>
      </div>
      {!volumeIsPlanning && <VisualCredit mode={heroVisual.mode} intent={heroVisual.intent} />}
    </section>

    <section class="section section--intro">
      <div class="section__head">
        <p class="eyebrow">MONTHLY VOLUME</p>
        <h2>{volume.data.title}</h2>
      </div>
      <p class="intro-copy">
        {volumeIsPlanning
          ? '最初のVol.は、テーマと記事構成を丁寧に準備しています。公開日が決まり次第、このページでお知らせします。'
          : '大人の日常を、少しだけ洒落たものにする。服、喫茶店、街歩き、道具、音楽をひとつのVol.として編んでいきます。'}
      </p>
    </section>

    {volumeIsPlanning ? (
      <section class="section planning-panel" aria-label="Editorial planning status">
        <p class="eyebrow">PREPARING</p>
        <h2>準備中</h2>
        <p>記事ラインナップと公開日は、決まり次第このページでお知らせします。</p>
      </section>
    ) : (
      <>
        {leadArticle && (
          <section class="section feature-band">
            <ArticleCard article={leadArticle} emphasis />
          </section>
        )}

        {secondaryArticles.length > 0 && (
          <section class="section">
            <div class="section__head section__head--row">
              <div>
                <p class="eyebrow">LATEST</p>
                <h2>{articleSectionTitle}</h2>
              </div>
              <a class="text-link" href={assetPath(`/volumes/${volume.slug}/`)}>View all</a>
            </div>
            <div class="article-grid">
              {secondaryArticles.map((article) => <ArticleCard article={article} />)}
            </div>
          </section>
        )}
      </>
    )}

    <section class="section category-strip" aria-label="Categories">
      {categories.map((category) => (
        <a href={assetPath(`/${category.slug}/`)}>
          <span>{category.label}</span>
          <small>{category.description}</small>
        </a>
      ))}
    </section>
  </main>
</BaseLayout>