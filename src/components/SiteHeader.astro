---
import { assetPath } from '../lib/kotatsu';

const nav = [
  ['STYLE', '/style/'],
  ['LIFE', '/life/'],
  ['WEEKEND', '/weekend/'],
  ['CULTURE', '/culture/'],
  ['PEOPLE', '/people/'],
  ['SHOPPING', '/shopping/'],
  ['VOLUMES', '/volumes/', 'VOL.']
];
---
<header class="site-header">
  <a class="site-mark" href={assetPath('/')} aria-label="KOTATSU home">
    <img src={assetPath('/logo.svg')} alt="KOTATSU" />
  </a>
  <nav class="site-nav" aria-label="Primary navigation">
    {nav.map(([label, path, mobileLabel]) => (
      <a href={assetPath(path)} data-mobile-label={mobileLabel}>{label}</a>
    ))}
  </nav>
</header>

