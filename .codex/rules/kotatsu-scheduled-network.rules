prefix_rule(
    pattern = ["node", "scripts/editorial/kotatsu-github.mjs"],
    decision = "allow",
    justification = "The wrapper restricts unattended GitHub operations to withbugs/kotatsu and an explicit operation allowlist.",
    match = [
        "node scripts/editorial/kotatsu-github.mjs issue list --repo withbugs/kotatsu --state open",
        "node scripts/editorial/kotatsu-github.mjs pr view 65 --repo withbugs/kotatsu",
    ],
    not_match = [
        "gh issue list --repo withbugs/kotatsu",
        "node scripts/editorial/another-script.mjs issue list --repo withbugs/kotatsu",
    ],
)

prefix_rule(
    pattern = ["node", "scripts/editorial/kotatsu-git-remote.mjs"],
    decision = "allow",
    justification = "The wrapper permits only origin fetches and HEAD pushes to approved non-main branch families.",
    match = [
        "node scripts/editorial/kotatsu-git-remote.mjs fetch origin main",
        "node scripts/editorial/kotatsu-git-remote.mjs push origin HEAD:article/issue-52-weekend-small-summer-outing",
    ],
    not_match = [
        "git push origin main",
        "node scripts/editorial/another-script.mjs fetch origin main",
    ],
)

prefix_rule(
    pattern = ["node", "scripts/editorial/close-complete-milestones.mjs"],
    decision = "allow",
    justification = "The KOTATSU closeout script is repository-locked and closes only mechanically eligible volume milestones.",
    match = [
        "node scripts/editorial/close-complete-milestones.mjs --apply",
    ],
    not_match = [
        "node scripts/editorial/another-script.mjs --apply",
    ],
)

prefix_rule(
    pattern = ["node", "scripts/editorial/monthly-planning-recovery.mjs"],
    decision = "allow",
    justification = "The repository-locked script detects overdue monthly planning and creates at most one missing future-volume milestone and research Issue.",
    match = [
        "node scripts/editorial/monthly-planning-recovery.mjs --apply",
    ],
    not_match = [
        "node scripts/editorial/another-script.mjs --apply",
    ],
)

prefix_rule(
    pattern = ["node", "scripts/editorial/actions-recovery.mjs"],
    decision = "allow",
    justification = "The repository-locked recovery command verifies required workflow names and article head SHA before bounded cancel and rerun operations.",
    match = [
        "node scripts/editorial/actions-recovery.mjs --ci-run=123 --visual-run=456 --head-sha=0123456789abcdef0123456789abcdef01234567 --apply",
    ],
    not_match = [
        "node scripts/editorial/another-script.mjs --ci-run=123 --visual-run=456 --head-sha=0123456789abcdef0123456789abcdef01234567 --apply",
    ],
)

prefix_rule(
    pattern = ["pnpm", "recovery:actions"],
    decision = "allow",
    justification = "This package alias invokes only the repository-locked required-Actions recovery command.",
    match = [
        "pnpm recovery:actions -- --ci-run=123 --visual-run=456 --head-sha=0123456789abcdef0123456789abcdef01234567 --apply",
    ],
    not_match = [
        "pnpm another-script -- --ci-run=123 --visual-run=456 --head-sha=0123456789abcdef0123456789abcdef01234567 --apply",
    ],
)

prefix_rule(
    pattern = ["pnpm", "install", "--offline", "--frozen-lockfile", "--ignore-scripts"],
    decision = "allow",
    justification = "Scheduled worktrees restore the frozen dependency set from the local pnpm store without network access or lifecycle scripts.",
    match = [
        "pnpm install --offline --frozen-lockfile --ignore-scripts",
    ],
    not_match = [
        "pnpm install",
        "pnpm install --frozen-lockfile",
        "pnpm install --offline",
    ],
)
